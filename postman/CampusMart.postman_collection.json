              "raw": "{{base_url}}/api/seller/dashboard/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "seller",
                "dashboard"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('seven bars', () => pm.expect(pm.response.json().last_7_days.length).to.eql(7));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}