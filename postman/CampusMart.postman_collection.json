    {
      "name": "Auth",
      "item": [
        {
          "name": "1 Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Tejdeep\",\n  \"email\": \"t@campus.edu\",\n  \"password\": \"secret123\",\n  \"user_type\": \"student\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 400 if name exists', () => pm.expect([201,400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Login (Priya, seller)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Priya\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('access', j.access);",
                  "pm.collectionVariables.set('refresh', j.refresh);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2b Login (Arjun, student)",
